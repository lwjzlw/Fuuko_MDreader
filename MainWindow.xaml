<Window x:Class="MarkdownReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Markdown 阅读器" Icon="pack://application:,,,/MarkdownReader;component/app.ico"
        Height="800" Width="1160" MinWidth="360" MinHeight="420"
        FontFamily="Geist, Plus Jakarta Sans, Manrope, Segoe UI Variable Text, Microsoft YaHei UI"
        Typography.NumeralAlignment="Tabular" Typography.SlashedZero="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AllowDrop="True" PreviewDragOver="OnFileDragOver" PreviewDrop="OnDrop"
        PreviewKeyDown="OnShortcut" KeyDown="OnKeyDown" Closing="OnClosing"
        SizeChanged="OnWindowSizeChanged" SourceInitialized="OnSourceInitialized"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <FontFamily x:Key="UiFontFamily">Geist, Plus Jakarta Sans, Manrope, Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Geist Mono, JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 基础按钮：透明底，150ms 悬停淡入，键盘焦点环，禁用降透明度 -->
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" />
              <Border x:Name="HoverLayer"
                      Background="{DynamicResource HoverBrush}"
                      CornerRadius="6"
                      Opacity="0"
                      IsHitTestVisible="False" />
              <Border x:Name="FocusRing"
                      BorderBrush="{DynamicResource AccentBrush}"
                      BorderThickness="1.5"
                      CornerRadius="6"
                      Opacity="0"
                      IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1.0" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0.0" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1.0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 图标按钮：顶栏与格式栏的主要操作 -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryFgBrush}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 视图分段：浅底容器 + 当前项白底，不加阴影 -->
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Background" Value="{DynamicResource BgBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 侧栏标签：文字 + 当前项下划线 -->
    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="0,0,0,2" Padding="0,6,0,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryFgBrush}" />
              </Trigger>
              <Trigger Property="Tag" Value="Active">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FgBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 侧栏列表项 -->
    <Style x:Key="SidebarItemButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="12.5" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 格式栏按钮 -->
    <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryFgBrush}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
          <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FormatIconButton" TargetType="Button" BasedOn="{StaticResource FormatButton}">
      <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 状态栏可点击项 -->
    <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- 横幅操作按钮 -->
    <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 主要动作按钮（空状态） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{DynamicResource FgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    </Style>

    <!-- 菜单：扁平圆角浮层 -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,10,10">
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.14" />
              </Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="6,6,10,6" MinWidth="232">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource FgBrush}" Visibility="Hidden" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                           FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="8,4" Background="{DynamicResource BorderBrush}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 快速切换列表项 -->
    <Style x:Key="PaletteItem" TargetType="ListBoxItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主菜单（顶栏“更多”） -->
    <ContextMenu x:Key="MoreMenu">
      <MenuItem Header="新建" InputGestureText="Ctrl+N" Click="OnNewClick" />
      <MenuItem Header="打开…" InputGestureText="Ctrl+O" Click="OnOpenClick" />
      <MenuItem Header="快速切换文档…" InputGestureText="Ctrl+P" Click="OnQuickOpenClick" />
      <MenuItem Header="重新加载" InputGestureText="F5" Click="OnReloadClick" />
      <Separator />
      <MenuItem Header="保存" InputGestureText="Ctrl+S" Click="OnSaveClick" />
      <MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S" Click="OnSaveAsClick" />
      <MenuItem Header="导出为 PDF…" InputGestureText="Ctrl+Shift+E" Click="OnExportPdfClick" />
      <Separator />
      <MenuItem Header="复制文件路径" Click="OnCopyPathClick" />
      <MenuItem Header="在资源管理器中显示" Click="OnRevealFolderClick" />
      <MenuItem Header="复制全文" Click="OnCopyAllClick" />
      <Separator />
      <MenuItem Header="放大字号" InputGestureText="Ctrl+=" Click="OnFontUp" />
      <MenuItem Header="缩小字号" InputGestureText="Ctrl+-" Click="OnFontDown" />
      <MenuItem Header="重置字号" InputGestureText="Ctrl+0" Click="OnFontResetClick" />
      <Separator />
      <MenuItem Header="显示侧栏" InputGestureText="Ctrl+Shift+B" Click="OnToggleSidebarClick" Tag="Sidebar" />
      <MenuItem Header="专注模式" InputGestureText="F11" Click="OnToggleFocusClick" Tag="Focus" />
      <MenuItem Header="深色主题" InputGestureText="Ctrl+Shift+L" Click="OnToggleThemeClick" Tag="Dark" />
      <MenuItem Header="源码自动折行" InputGestureText="Alt+Z" Click="OnToggleWordWrapClick" Tag="Wrap" />
      <MenuItem Header="外部修改时自动同步" Click="OnToggleAutoReloadClick" Tag="AutoReload" />
      <Separator />
      <MenuItem Header="快捷键" InputGestureText="F1" Click="OnShowShortcutsClick" />
    </ContextMenu>

    <!-- 文件名右键菜单 -->
    <ContextMenu x:Key="FileMenu">
      <MenuItem Header="复制文件路径" Click="OnCopyPathClick" />
      <MenuItem Header="在资源管理器中显示" Click="OnRevealFolderClick" />
      <MenuItem Header="导出为 PDF…" InputGestureText="Ctrl+Shift+E" Click="OnExportPdfClick" />
      <MenuItem Header="重新加载" InputGestureText="F5" Click="OnReloadClick" />
    </ContextMenu>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <DockPanel>
      <!-- 顶栏：左导航 · 中文件名 · 右视图与少量常用动作 -->
      <Border x:Name="ToolbarBorder" DockPanel.Dock="Top"
              Background="{DynamicResource ToolbarBg}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" Padding="8,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButton}"
                    Content="&#xE700;" Click="OnToggleSidebarClick"
                    ToolTip="侧栏 (Ctrl+Shift+B)" />
            <Button x:Name="NavBackButton" Style="{StaticResource IconButton}" FontSize="12"
                    Content="&#xE72B;" IsEnabled="False" Click="OnNavBackClick"
                    ToolTip="后退 (Alt+←)" />
            <Button x:Name="NavForwardButton" Style="{StaticResource IconButton}" FontSize="12"
                    Content="&#xE72A;" IsEnabled="False" Click="OnNavForwardClick"
                    ToolTip="前进 (Alt+→)" />
            <!-- 兼容字段：自动化测试与旧快捷键通过反射访问 -->
            <Button x:Name="EditButton" Visibility="Collapsed" Click="OnToggleEdit" />
          </StackPanel>

          <!-- 文件名 + 所在目录（单个 TextBlock，空间不足时先截断目录） -->
          <Grid Grid.Column="1" MinWidth="0" Margin="12,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DirtyBadge" Grid.Column="0" Visibility="Collapsed"
                    Width="7" Height="7" CornerRadius="4" Margin="0,1,8,0"
                    Background="{DynamicResource WarningBrush}" ToolTip="有未保存的修改"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="FileLabel" Grid.Column="1" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource FgBrush}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ContextMenu="{StaticResource FileMenu}" />
          </Grid>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="ModeSegment" Background="{DynamicResource SubtleBg}" CornerRadius="8" Padding="2" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ModePreviewButton" Style="{StaticResource SegmentButton}"
                        Content="阅读" Tag="Active" Click="OnModePreviewClick"
                        ToolTip="阅读 (Ctrl+1)" />
                <Button x:Name="ModeSplitButton" Style="{StaticResource SegmentButton}"
                        Content="分栏" Click="OnModeSplitClick"
                        ToolTip="左写右看 (Ctrl+2)" />
                <Button x:Name="ModeEditButton" Style="{StaticResource SegmentButton}"
                        Content="源码" Click="OnModeEditClick"
                        ToolTip="源码 (Ctrl+3 / Ctrl+E)" />
              </StackPanel>
            </Border>
            <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="&#xE8E5;"
                    Click="OnOpenClick" ToolTip="打开 (Ctrl+O)" />
            <Button x:Name="SaveButton" Style="{StaticResource IconButton}" Content="&#xE74E;"
                    Click="OnSaveClick" ToolTip="保存 (Ctrl+S)" />
            <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButton}" Content="&#xE708;"
                    Click="OnToggleThemeClick" ToolTip="切换深浅色 (Ctrl+Shift+L)" />
            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="0"
                    Click="OnMoreClick" ToolTip="更多" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 内联错误 / 外部修改冲突横幅 -->
      <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed"
              Background="{DynamicResource DangerBgBrush}" Padding="14,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="ErrorBannerBadgeBorder" Grid.Column="0" Background="Transparent"
                  Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="ErrorBannerBadge" Text="错误" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}" />
          </Border>
          <TextBlock x:Name="ErrorBannerText" Grid.Column="1" VerticalAlignment="Center"
                     FontSize="12.5" Foreground="{DynamicResource FgBrush}"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button x:Name="ErrorPrimaryButton" Style="{StaticResource BannerButton}" FontWeight="SemiBold"
                    Content="重试" Visibility="Collapsed" Click="OnErrorPrimaryClick" />
            <Button x:Name="ErrorSecondaryButton" Style="{StaticResource BannerButton}"
                    Content="查看源码" Visibility="Collapsed" Click="OnErrorSecondaryClick" />
            <Button x:Name="ErrorDismissButton" Style="{StaticResource BannerButton}"
                    FontFamily="{StaticResource IconFontFamily}" FontSize="10" Padding="8,5"
                    Content="&#xE711;" ToolTip="关闭 (Esc)" Click="OnErrorDismissClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 底部状态栏 -->
      <Border x:Name="StatusBarBorder" DockPanel.Dock="Bottom"
              Background="{DynamicResource ToolbarBg}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0" Padding="12,2,6,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                     Typography.NumeralAlignment="Tabular"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <StackPanel x:Name="StatusMetricsPanel" Grid.Column="1" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock x:Name="CaretMetricText" FontSize="11.5" Margin="0,0,12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       Typography.NumeralAlignment="Tabular" Text="" />
            <TextBlock x:Name="StatsMetricText" FontSize="11.5" Margin="0,0,6,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       Typography.NumeralAlignment="Tabular" Text="" />
            <Button x:Name="EncodingMetricButton" Style="{StaticResource StatusButton}"
                    Content="UTF-8" Click="OnCycleEncodingClick"
                    ToolTip="文件编码：点击在 UTF-8 / UTF-8 BOM 之间切换（其他编码转为 UTF-8），保存后生效" />
            <Button x:Name="NewLineMetricButton" Style="{StaticResource StatusButton}"
                    Content="LF" Click="OnCycleNewLineClick"
                    ToolTip="换行符：点击在 LF / CRLF 之间切换，保存后生效" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 主区域：侧栏 + 画布 -->
      <Grid x:Name="WorkspaceGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="180" MaxWidth="420" />
          <ColumnDefinition x:Name="SidebarSplitterColumn" Width="1" />
          <ColumnDefinition Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource SidebarBg}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="14,6,12,8">
              <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                <Button x:Name="TabOutlineButton" Style="{StaticResource TabButton}"
                        Content="大纲" Tag="Active" Click="OnTabOutlineClick" />
                <Button x:Name="TabFilesButton" Style="{StaticResource TabButton}"
                        Content="文档" Click="OnTabFilesClick" />
              </StackPanel>
              <Border Background="{DynamicResource BgBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="8,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox x:Name="SidebarFilterBox" Grid.Column="1"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{DynamicResource FgBrush}"
                           CaretBrush="{DynamicResource FgBrush}"
                           FontSize="12" VerticalContentAlignment="Center"
                           TextChanged="OnSidebarFilterChanged" />
                  <TextBlock x:Name="SidebarFilterPlaceholder" Grid.Column="1"
                             Text="筛选" FontSize="12" Margin="2,0,0,0"
                             Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" IsHitTestVisible="False" />
                  <Button x:Name="ClearFilterButton" Grid.Column="2"
                          Style="{StaticResource ToolButton}" Content="&#xE711;"
                          FontFamily="{StaticResource IconFontFamily}" FontSize="9"
                          Foreground="{DynamicResource MutedBrush}"
                          Padding="4,2" Margin="4,0,0,0" Visibility="Collapsed"
                          Click="OnClearSidebarFilterClick" ToolTip="清空筛选" />
                </Grid>
              </Border>
            </StackPanel>

            <Grid>
              <Grid x:Name="OutlineTabPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,0,6,8">
                  <StackPanel x:Name="OutlineListPanel" />
                </ScrollViewer>
                <Border x:Name="OutlineEmptyState" Visibility="Collapsed" Padding="18,20">
                  <StackPanel>
                    <TextBlock x:Name="OutlineEmptyTitle" Text="没有标题"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryFgBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="OutlineEmptyDesc"
                               Text="用 # 到 #### 写标题，这里会生成目录。"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="18" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid x:Name="FilesTabPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,0,6,8">
                  <StackPanel>
                    <Grid Margin="10,4,8,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="此文件夹" FontSize="11.5"
                                 Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBlock x:Name="SiblingCountBadge" Grid.Column="1" Text="0" FontSize="11.5"
                                 Foreground="{DynamicResource MutedBrush}" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <StackPanel x:Name="SiblingFilesPanel" Margin="0,0,0,14" />

                    <Grid Margin="10,4,4,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="最近" FontSize="11.5"
                                 Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                      <Button x:Name="PruneRecentButton" Grid.Column="1" Style="{StaticResource ToolButton}"
                              Content="清理失效" Padding="6,1" FontSize="11.5"
                              Foreground="{DynamicResource MutedBrush}"
                              Click="OnPruneRecentClick" ToolTip="移除已不存在的最近文件记录" />
                    </Grid>
                    <StackPanel x:Name="RecentFilesPanel" />
                  </StackPanel>
                </ScrollViewer>
                <Border x:Name="FilesEmptyState" Visibility="Collapsed" Padding="18,20">
                  <StackPanel>
                    <TextBlock x:Name="FilesEmptyTitle" Text="暂无文档"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryFgBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="FilesEmptyDesc"
                               Text="打开一个本地 Markdown 文件后，这里会列出同文件夹的文档和最近记录。"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="18" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </DockPanel>
        </Border>

        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext" />

        <DockPanel Grid.Column="2" LastChildFill="True">
          <!-- 编辑格式栏（分栏 / 源码模式） -->
          <Border x:Name="EditFormatBar" DockPanel.Dock="Top" Visibility="Collapsed"
                  Background="{DynamicResource BgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1" Padding="10,3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button Style="{StaticResource FormatButton}" Content="H1" Tag="H1" FontWeight="SemiBold" Click="OnFormatActionClick" ToolTip="一级标题" />
                <Button Style="{StaticResource FormatButton}" Content="H2" Tag="H2" FontWeight="SemiBold" Click="OnFormatActionClick" ToolTip="二级标题" />
                <Button Style="{StaticResource FormatButton}" Content="H3" Tag="H3" FontWeight="SemiBold" Click="OnFormatActionClick" ToolTip="三级标题" />
                <Border Width="1" Height="14" Margin="6,0" Background="{DynamicResource BorderBrush}" />
                <Button Style="{StaticResource FormatButton}" Tag="Bold" Click="OnFormatActionClick" ToolTip="粗体 (Ctrl+B)">
                  <TextBlock Text="B" FontWeight="Bold" FontSize="13.5" />
                </Button>
                <Button Style="{StaticResource FormatButton}" Tag="Italic" Click="OnFormatActionClick" ToolTip="斜体 (Ctrl+I)">
                  <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia, Times New Roman" FontSize="14" />
                </Button>
                <Button Style="{StaticResource FormatButton}" Tag="Strike" Click="OnFormatActionClick" ToolTip="删除线 (Ctrl+Shift+X)">
                  <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="13.5" />
                </Button>
                <Button Style="{StaticResource FormatButton}" Tag="InlineCode" Click="OnFormatActionClick" ToolTip="行内代码 (Ctrl+`)">
                  <TextBlock Text="`c`" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" />
                </Button>
                <Button Style="{StaticResource FormatIconButton}" Content="&#xE943;" Tag="CodeBlock" Click="OnFormatActionClick" ToolTip="代码块" />
                <Border Width="1" Height="14" Margin="6,0" Background="{DynamicResource BorderBrush}" />
                <Button Style="{StaticResource FormatIconButton}" Content="&#xE71B;" Tag="Link" Click="OnFormatActionClick" ToolTip="链接 (Ctrl+K)" />
                <Button Style="{StaticResource FormatIconButton}" Content="&#xE8B9;" Tag="Image" Click="OnFormatActionClick" ToolTip="插入图片（也可直接粘贴截图或拖入图片）" />
                <Button Style="{StaticResource FormatButton}" Tag="Quote" Click="OnFormatActionClick" ToolTip="引用">
                  <TextBlock Text="❝" FontSize="14" />
                </Button>
                <Button Style="{StaticResource FormatIconButton}" Content="&#xE8FD;" Tag="BulletList" Click="OnFormatActionClick" ToolTip="无序列表" />
                <Button Style="{StaticResource FormatButton}" Tag="OrderedList" Click="OnFormatActionClick" ToolTip="有序列表">
                  <TextBlock Text="1." FontFamily="{StaticResource MonoFontFamily}" FontSize="12" />
                </Button>
                <Button Style="{StaticResource FormatIconButton}" Content="&#xE73A;" Tag="TaskList" Click="OnFormatActionClick" ToolTip="任务 / 勾选切换" />
                <Button Style="{StaticResource FormatButton}" Tag="Table" Click="OnFormatActionClick" ToolTip="插入表格">
                  <TextBlock Text="⊞" FontSize="15" />
                </Button>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="WordWrapButton" Style="{StaticResource FormatButton}"
                        Content="折行" Click="OnToggleWordWrapClick" ToolTip="自动折行 (Alt+Z)" />
                <Button Style="{StaticResource FormatIconButton}" Content="&#xE721;" Margin="0"
                        Click="OnFindClick" ToolTip="查找 (Ctrl+F)" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid x:Name="ContentStageGrid">
            <Grid x:Name="SplitContainerGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorPaneColumn" Width="0" />
                <ColumnDefinition x:Name="SplitDividerColumn" Width="0" />
                <ColumnDefinition x:Name="PreviewPaneColumn" Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition x:Name="TopPaneRow" Height="*" />
                <RowDefinition x:Name="HorizontalSplitDividerRow" Height="0" />
                <RowDefinition x:Name="BottomPaneRow" Height="0" />
              </Grid.RowDefinitions>

              <Border x:Name="EditorHost" Grid.Column="0" Grid.Row="0" Visibility="Collapsed"
                      Background="{DynamicResource BgBrush}" SizeChanged="OnCanvasSizeChanged">
                <edit:TextEditor x:Name="Editor" Visibility="Collapsed" WordWrap="True"
                                 ShowLineNumbers="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="24,20,24,40" Background="Transparent"
                                 Foreground="{DynamicResource FgBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}" FontSize="15" />
              </Border>

              <Border x:Name="VerticalSplitDivider" Grid.Column="1" Grid.Row="0" Visibility="Collapsed"
                      Background="{DynamicResource BorderBrush}" Width="1" />
              <Border x:Name="HorizontalSplitDivider" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                      Visibility="Collapsed" Background="{DynamicResource BorderBrush}" Height="1" />

              <Border x:Name="PreviewHost" Grid.Column="2" Grid.Row="0"
                      Background="{DynamicResource BgBrush}" SizeChanged="OnCanvasSizeChanged">
                <FlowDocumentScrollViewer x:Name="Viewer" IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          IsSelectionEnabled="True" Zoom="100" Background="Transparent" />
              </Border>
            </Grid>

            <!-- 空状态：一列居中、左对齐，只放常用入口与最近文件 -->
            <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="{DynamicResource BgBrush}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" Margin="32,56,32,32" HorizontalAlignment="Stretch">
                  <TextBlock Text="Markdown 阅读器" FontSize="24" FontWeight="SemiBold"
                             Foreground="{DynamicResource FgBrush}" Margin="0,0,0,6" />
                  <TextBlock Text="把 .md 文件拖进窗口，或从这里开始。" FontSize="13.5"
                             Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22" />
                  <WrapPanel Margin="0,0,0,28">
                    <Button Style="{StaticResource PrimaryButton}" Content="打开文件" Click="OnOpenClick" ToolTip="Ctrl+O" />
                    <Button Style="{StaticResource SecondaryButton}" Content="新建" Click="OnNewClick" ToolTip="Ctrl+N" />
                    <Button Style="{StaticResource SecondaryButton}" Content="从剪贴板新建" Click="OnNewFromClipboardClick" />
                    <Button Style="{StaticResource ToolButton}" Padding="12,7" Margin="0,0,0,8"
                            Foreground="{DynamicResource MutedBrush}"
                            Content="查看排版示例" Click="OnDismissEmptyGuideClick" />
                  </WrapPanel>

                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最近" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryFgBrush}" />
                    <TextBlock x:Name="EmptyStateRecentCountText" Grid.Column="1" Text=""
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Typography.NumeralAlignment="Tabular" />
                  </Grid>
                  <StackPanel x:Name="EmptyStateRecentTable" Margin="-10,0,-10,20" />

                  <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                    <Run Text="Ctrl+P" FontFamily="{StaticResource MonoFontFamily}" />
                    <Run Text=" 快速切换文档    " />
                    <Run Text="F1" FontFamily="{StaticResource MonoFontFamily}" />
                    <Run Text=" 全部快捷键" />
                  </TextBlock>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- 加载骨架屏 -->
            <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="{DynamicResource BgBrush}">
              <StackPanel Width="600" Margin="32,48,32,32" HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingStatusText" Text="正在排版…"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20" />
                <Border Height="26" Width="300" HorizontalAlignment="Left" Background="{DynamicResource SubtleBg}" CornerRadius="5" Margin="0,0,0,24" />
                <Border Height="12" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleBg}" CornerRadius="4" Margin="0,0,0,10" />
                <Border Height="12" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleBg}" CornerRadius="4" Margin="0,0,40,10" />
                <Border Height="12" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleBg}" CornerRadius="4" Margin="0,0,120,24" />
                <Border Height="80" HorizontalAlignment="Stretch" Background="{DynamicResource SidebarBg}" CornerRadius="6" Margin="0,0,0,24" />
                <Border Height="12" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleBg}" CornerRadius="4" Margin="0,0,0,10" />
                <Border Height="12" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleBg}" CornerRadius="4" Margin="0,0,200,0" />
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Grid>
    </DockPanel>

    <!-- 快速切换（Ctrl+P）：文件名筛选；# 开头跳转标题 -->
    <Grid x:Name="QuickOpenOverlay" Visibility="Collapsed" Background="#1A000000"
          MouseLeftButtonDown="OnOverlayBackgroundClick">
      <Border MaxWidth="580" Margin="16,64,16,16" VerticalAlignment="Top"
              Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="6"
              MouseLeftButtonDown="OnOverlayCardClick">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.16" />
        </Border.Effect>
        <StackPanel>
          <Grid Margin="4,2,4,4">
            <TextBox x:Name="QuickOpenBox" FontSize="14" Padding="6,7"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                     TextChanged="OnQuickOpenTextChanged" PreviewKeyDown="OnQuickOpenKeyDown" />
            <TextBlock x:Name="QuickOpenPlaceholder" Text="输入文件名切换文档，# 开头跳转到标题"
                       FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedBrush}" />
          </Grid>
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="-6,0,-6,4" />
          <ListBox x:Name="QuickOpenList" MaxHeight="360" BorderThickness="0" Background="Transparent"
                   ItemContainerStyle="{StaticResource PaletteItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseLeftButtonUp="OnQuickOpenListClick" />
          <TextBlock x:Name="QuickOpenEmptyText" Visibility="Collapsed" Margin="10,8,10,10"
                     FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Text="没有匹配项" />
          <TextBlock Margin="10,6,10,4" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                     Text="↑↓ 选择 · Enter 打开 · Esc 关闭" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 快捷键速查（F1） -->
    <Grid x:Name="ShortcutsOverlay" Visibility="Collapsed" Background="#1A000000"
          MouseLeftButtonDown="OnOverlayBackgroundClick">
      <Border MaxWidth="560" Margin="16,56,16,16" VerticalAlignment="Top"
              Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="22,18,22,16"
              MouseLeftButtonDown="OnOverlayCardClick">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.16" />
        </Border.Effect>
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <TextBlock Text="快捷键" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" />
            <TextBlock Text="Esc 关闭" HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" />
          </Grid>
          <ScrollViewer x:Name="ShortcutsScroller" MaxHeight="460" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ShortcutsGrid" Margin="0,0,14,0" Typography.NumeralAlignment="Tabular" />
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
